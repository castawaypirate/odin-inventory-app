<div><%=game.title%></div>

<div>
  <% for(let publisher of game.publishers) { %>
  <div><%=publisher.name%></div>
  <%}%>
</div>

<div>
  <% for(let developer of game.developers) { %>
  <div><%=developer.name%></div>
  <%}%>
</div>

<div>
  <% for(let genre of game.genres) { %>
  <div><%=genre.name%></div>
  <%}%>
</div>

<div><%=game.gameEngine?.name%></div>

<div>
  <% for(let metrics of game.gameMetrics) { %>
  <div><%=metrics.copies_sold%></div>
  <div><%=metrics.budget%></div>
  <div><%=metrics.revenue%></div>
  <%}%>
</div>

<div><%=game.release_date%></div>

<div>
  <% for(let platform of game.platforms) { %>
  <div><%=platform%></div>
  <%}%>
</div>

<% if (game.image_path) {%> <% console.log(game.image_path) %>
<img src="<%=game.image_path%>" alt="<%=game.title%> cover" />
<% } %>
