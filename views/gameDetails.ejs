<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link href="/css/gameDetails.css" rel="stylesheet" />
    <script src="/js/gameDetails.js" defer></script>
    <title>Game Details</title>
  </head>

  <body>
    <div class="content">
      <%- include("partial/confirmModal")%>
      <% if (locals.game) {%> <% if (game.image_path) {%>
      <img src="<%=game.image_path%>" alt="<%=game.title%> cover" />
      <% } else { %>
      <img
        src="/uploads/images/game cover placeholder.svg"
        alt="an image of a gamepad serving as placeholder for games without uploaded cover"
      />
      <%}%>
      <div class="game-details">
        <h1><%=game.title%></h1>

        <p class="secondary"><%=game.description%></p>

        <div>
          <h3>Release date</h3>
          <% if (game.release_date) { %>
          <div class="secondary"><%=game.release_date%></div>
          <%} else {%>
          <div class="missing">----</div>
          <%}%>
        </div>

        <div>
          <h3>Publishers</h3>
            <%if (game.publishers?.length !== 0) {%>
            <div class="game-publishers secondary">
              <% for (let i=0;i<game.publishers.length;i++) { %>
              <div class="publisher"><%=game.publishers[i].name%></div>
                <% if (i!==game.publishers.length-1) {%>
              <div class="divider">|</div>
              <%}%>
              <%}%>
            </div>
            <% } else {%>
            <div class="missing">TBA</div>
            <%}%>
        </div>

        <div>
          <h3>Developers</h3>
            <%if (game.developers?.length !== 0) {%>
            <div class="game-developers secondary">
              <% for (let i=0;i<game.developers.length;i++) { %>
              <div class="developers"><%=game.developers[i].name%></div>
                <% if (i!==game.developers.length-1) {%>
              <div class="divider">|</div>
              <%}%>
              <%}%>
            </div>
            <% } else {%>
            <div class="missing">TBA</div>
            <%}%>
        </div>

        <div>
          <h3>Genres</h3>
            <%if (game.genres?.length !== 0) {%>
            <div class="game-genres secondary">
              <% for (let i=0;i<game.genres.length;i++) { %>
              <div class="genres"><%=game.genres[i].name%></div>
                <% if (i!==game.genres.length-1) {%>
              <div class="divider">|</div>
              <%}%>
              <%}%>
            </div>
            <% } else {%>
            <div class="missing">Uncategorized</div>
            <%}%>
        </div>

        <div>
          <h3>Platforms</h3>
            <%if (game.platforms?.length !== 0) {%>
            <div class="game-platforms secondary">
              <% for (let i=0;i<game.platforms.length;i++) { %>
              <div class="platform"><%=game.platforms[i]%></div>
                <% if (i!==game.platforms.length-1) {%>
                <div class="divider">|</div>
                <%}%>
              <%}%>
            </div>
            <% } else {%>
            <div class="missing">Not Specified</div>
            <%}%>
        </div>

        <div>
          <h3>Game Engine</h3>
          
          <%if (game.gameEngine) {%>
          <div class="game-engine secondary"><%=game.gameEngine?.name%></div>
          <%} else {%>
          <div class="missing">
            Unknown
          </div>
          <%}%>
        </div>
        <div class="game-metrics">
          <div>
            <h3>Copies sold</h3>  
            <%if (game.gameMetrics?.copies_sold) {%>
            <div class="secondary"><%=game.gameMetrics.copies_sold%></div>
            <%} else {%>
            <div class="missing">
              Data Unavailable
            </div>
            <%}%>
          </div>
          <div>
            <h3>Budget</h3>
            <%if (game.gameMetrics?.budget) {%>
            <div class="secondary"><%=game.gameMetrics.budget%></div>
            <%} else {%>
            <div class="missing">
              Undisclosed
            </div>
            <%}%>
          </div>
          <div>
            <h3>Revenue</h3>
            <%if (game.gameMetrics?.revenue) {%>
            <div class="secondary"><%=game.gameMetrics.revenue%></div>
            <%} else {%>
            <div class="missing">
              Undisclosed
            </div>
            <%}%>
          </div>
        </div>

      </div>
      <div class="links">
       <a href="/game/<%=game.id%>/update">Edit</a> 
       <div class="divider">|</div>
       <a href="/game/<%=game.id%>/delete">Delete</a> 
       <div class="divider">|</div>
       <a href="/">Back to inventory</a> 
      </div>
    </div>
    <% } else if (locals.error === 400) {%>
    <h1>Bad request</h1>
    <a href="/">Back to inventory</a> 
    <% } else {%>
    <h1>Game not found</h1>
    <a href="/">Back to inventory</a> 
    <% } %>
  </body>
</html>
