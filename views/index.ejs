<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link href="/css/index.css" rel="stylesheet" />
    <script src="/js/index.js" defer></script>
    <title>Game Inventory</title>
  </head>

  <body>
    <div class="content">
      <div style="margin: 1rem 0;">
        <a href="/create">Create Game</a>
      </div>
      <div class="card-grid">
        <% if (locals.games?.length > 0) { %> <% for(let game of games) { %>
        <div class="card" data-id="<%=game.id%>">
          <% if (game.image_path) {%>
          <img src="<%=game.image_path%>" alt="<%=game.title%> cover" />
          <% } else { %>
          <img
            src="/uploads/images/game cover placeholder.svg"
            alt="an image of a gamepad serving as placeholder for games without uploaded cover"
          />
          <%}%>
          <div class="card-details">
            <h3><%=game.title%></h3>
            <%if (game.publishers?.length !== 0) {%>
            <div class="card-publishers">
              <% for (let i=0;i<game.publishers.length;i++) { %>
              <div class="publisher"><%=game.publishers[i].name%></div>
                <% if (i!==game.publishers.length-1) {%>
              <div class="divider">|</div>
              <%}%>
              <%}%>
            </div>
            <% } else {%>
            <div>TBA</div>
            <%}%> <%if (game.release_date) {%>
            <div><%=new Date(game.release_date).getFullYear()%></div>
            <%} else {%>
            <div>----</div>
            <% } %>
          </div>
        </div>
        <%}%> <%} else {%>
        <h1>No games currently in the inventory</h1>
        <% } %>
      </div>
    </div>
  </body>
</html>
