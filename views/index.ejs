<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link href="/css/index.css" rel="stylesheet" />
    <script src="/js/index.js" defer></script>
    <title>Game Inventory</title>
  </head>

  <body>
    <div class="content">
      <%- include("partial/confirmModal")%>
      <header>
        <div class="header-left">
          <h1><a href="/">Odin Game Inventory</a></h1> 
          <div class="create">
            <a href="/create">+ New</a>
          </div>
        </div>
          <form class="search-form" action="/search" method="GET">
            <input value="<%=searchQuery%>" type="text" name="search" id="search" placeholder="Enter game title...">
          </form>
      </header>
      <div class="main-layout">
       <aside>
        <form class="side-form" action="/search" method="GET">
          <div class="genres">
            <h3 class="filter-title">
              Genres
            </h3>
              <% if (locals.genres?.length > 0) { %> 
                <% for(let genre of genres) { %>
                <div class="checkbox-group">
                  <input type="checkbox" id="<%=genre.id%>" name="genres" value="<%=genre.name%>" onchange="this.form.requestSubmit()" <%=(genre.checked) ? 'checked' : ''%>/>
                  <label class="secondary" for="<%=genre.id%>"><%=genre.name%></label>
                </div>
                <%}%>
              <%}%>
          </div>
          <div class="publishers">
            <h3 class="filter-title">
              Publishers
            </h3>
              <% if (locals.publishers?.length > 0) { %> 
                <% for(let publisher of publishers) { %>
                <div class="checkbox-group">
                  <input type="checkbox" id="<%=publisher.id%>" name="publishers" value="<%=publisher.name%>" onchange="this.form.requestSubmit()" <%=(publisher.checked) ? 'checked' : ''%>/>
                  <label class="secondary" for="<%=publisher.id%>"><%=publisher.name%></label>
                </div>
                <%}%>
              <%}%>
          </div>
          <div class="developers">
            <h3 class="filter-title">
              Developers
            </h3>
              <% if (locals.developers?.length > 0) { %> 
                <% for(let developer of developers) { %>
                <div class="checkbox-group">
                  <input type="checkbox" id="<%=developer.id%>" name="developers" value="<%=developer.name%>" onchange="this.form.requestSubmit()" <%=(developer.checked) ? 'checked' : ''%>/>
                  <label class="secondary" for="<%=developer.id%>"><%=developer.name%></label>
                </div>
                <%}%>
              <%}%>
          </div>
        </form>
       </aside> 
        <div class="card-grid">
          <% if (locals.games?.length > 0) { %> <% for(let game of games) { %>
          <div class="card" data-id="<%=game.id%>">
            <% if (game.image_path) {%>
            <img src="<%=game.image_path%>" alt="<%=game.title%> cover" />
            <% } else { %>
            <img
              src="/uploads/images/game cover placeholder.svg"
              alt="an image of a gamepad serving as placeholder for games without uploaded cover"
            />
            <%}%>
            <div class="card-details">
              <h3><%=game.title%></h3>
              <%if (game.publishers?.length !== 0) {%>
              <div class="card-publishers">
                <% for (let i=0;i<game.publishers.length;i++) { %>
                <div class="publisher secondary"><%=game.publishers[i].name%></div>
                  <% if (i!==game.publishers.length-1) {%>
                <div class="divider">|</div>
                <%}%>
                <%}%>
              </div>
              <% } else {%>
              <div class="missing">TBA</div>
              <%}%> <%if (game.release_date) {%>
              <div class="secondary"><%=new Date(game.release_date).getFullYear()%></div>
              <%} else {%>
              <div class="missing">----</div>
              <% } %>
            </div>
          </div>
          <%}%> <%} else {%>
          <h1>No games found</h1>
          <% } %>
        </div>
      </div>
    </div>
  </body>
</html>
